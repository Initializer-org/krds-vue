{
  "name": "@krds.ui/vue",
  "version": "0.0.24",
  "description": "대한민국 정부 디자인 시스템(KRDS) Vue 3 컴포넌트 라이브러리 - KRDS 원본의 마크업·스타일·키보드 동작을 그대로 따르는 TypeScript 컴포넌트, 접근성 자동 검사, Nuxt SSR 지원",
  "keywords": [
    "krds",
    "design-system",
    "vue",
    "vue3",
    "components",
    "ui-library",
    "typescript",
    "korea",
    "korean",
    "government",
    "government-design-system",
    "public-sector",
    "accessibility",
    "a11y",
    "nuxt",
    "ssr"
  ],
  "homepage": "https://krds.initializer.org",
  "bugs": {
    "url": "https://github.com/Initializer-org/krds-vue/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Initializer-org/krds-vue.git"
  },
  "license": "MIT",
  "author": "Initializer Team",
  "type": "module",
  "main": "./dist/krds-vue.es.js",
  "module": "./dist/krds-vue.es.js",
  "types": "./dist/types/index.d.ts",
  "web-types": "./dist/web-types.json",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/krds-vue.es.js"
    },
    "./global": {
      "types": "./global.d.ts"
    },
    "./dist/style.css": {
      "types": "./style.d.ts",
      "default": "./dist/style.css"
    },
    "./style": {
      "types": "./style.d.ts",
      "default": "./dist/style.css"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "global.d.ts",
    "style.d.ts"
  ],
  "scripts": {
    "build": "pnpm run type-check && pnpm run build:lib",
    "build:lib": "vite build && node scripts/web-types.mjs",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "type-check": "node node_modules/typescript7/bin/tsc --noEmit && vue-tsc --noEmit -p docs",
    "lint": "oxlint",
    "format": "oxfmt",
    "bundle-size": "size-limit",
    "prepublishOnly": "pnpm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@size-limit/file": "^14.2.0",
    "@size-limit/rolldown": "^14.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "axe-core": "~4.14.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.87.0",
    "playwright": "^1.64.0",
    "sass": "^1.105.1",
    "size-limit": "^14.2.0",
    "source-map-explorer": "^2.5.3",
    "typescript": "6.0.3",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "^4.1.12",
    "vue": "^3.5.43",
    "vue-component-meta": "^3.3.12",
    "vue-tsc": "^3.3.13"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@12.11.2",
  "size-limit": [
    {
      "path": "dist/krds-vue.es.js",
      "limit": "28 kB",
      "rolldown": false
    },
    {
      "path": "dist/style.css",
      "limit": "60 kB",
      "rolldown": false
    },
    {
      "name": "tree-shaking: { KrdsButton }",
      "path": "dist/krds-vue.es.js",
      "import": "{ KrdsButton }",
      "limit": "2 kB"
    }
  ]
}
